{
  "version": "1.0.0",
  "description": "Simple Nodejs CRUD API",
  "name": "nodejs-crud-api",
  "type": "module",
  "scripts": {
    "build": "webpack --mode=production --node-env=production",
    "build:dev": "webpack --mode=development",
    "watch": "webpack --watch",
    "start:dev": "nodemon --exec node --env-file .env --loader ts-node/esm src/index.ts",
    "start:prod": "webpack && node --env-file .env dist/main.js",
    "start:multi": "node --env-file .env --loader ts-node/esm src/index.ts --multi",
    "lint": "eslint",
    "test": "jest --verbose"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "globals": "^16.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "webpack": "^5.99.8",
    "webpack-cli": "^6.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DmirtyUsov/nodejs-crud-api.git"
  },
  "author": "Dima Usov <dmitry.usov@yahoo.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DmirtyUsov/nodejs-crud-api/issues"
  },
  "homepage": "https://github.com/DmirtyUsov/nodejs-crud-api#readme",
  "dependencies": {
    "uuid": "^11.1.0"
  }
}
